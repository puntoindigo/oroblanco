# Neon Postgres — completar desde Vercel Marketplace
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://tu-dominio.com

# Admin single user
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD_HASH=bcrypt-hash-del-password

# Resend
RESEND_API_KEY=re_xxxx

# Email destino para presupuestos
EMAIL_TO=tu-email@ejemplo.com

# WhatsApp (número sin + ni espacios)
WHATSAPP_NUMBER=5493412345678
