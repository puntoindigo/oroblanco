generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EstadoViaje {
  PRESUPUESTO
  PENDIENTE
  EN_CURSO
  FACTURADO
  COBRADO
  CANCELADO
}

enum TipoGasto {
  COMBUSTIBLE
  PEAJE
  MANTENIMIENTO
  NEUMATICOS
  SEGURO
  IMPUESTO
  SUELDO
  OTRO
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())
}

model Vehiculo {
  id        String   @id @default(cuid())
  patente   String   @unique
  marca     String
  modelo    String
  anio      Int?
  tipo      String   @default("Camión")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  viajes    Viaje[]
  gastos    Gasto[]
}

model Viaje {
  id            String      @id @default(cuid())
  estado        EstadoViaje @default(PRESUPUESTO)
  fecha         DateTime?
  fechaSolicitud DateTime?
  origen        String
  destino       String
  tipoCarga     String      @default("Carga General")
  pesoVgm       Float?
  tara          Float?
  cliente       String
  empresa       String?
  clienteEmail  String?
  clienteTel    String?
  precio        Float?
  precioConIva  Boolean  @default(true)
  nroRemito     String?
  mensaje       String?
  notas         String?
  vehiculoId    String?
  vehiculo      Vehiculo?   @relation(fields: [vehiculoId], references: [id])
  gastos        Gasto[]
  facturas      Factura[]
  utmSource     String?
  utmCampaign   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Gasto {
  id             String    @id @default(cuid())
  fecha          DateTime
  descripcion    String
  monto          Float
  tipo           TipoGasto @default(OTRO)
  nroComprobante String?
  vehiculoId     String?
  vehiculo       Vehiculo? @relation(fields: [vehiculoId], references: [id])
  viajeId        String?
  viaje          Viaje?    @relation(fields: [viajeId], references: [id])
  createdAt      DateTime  @default(now())
}

model Factura {
  id            String   @id @default(cuid())
  movimiento    String   @default("emitida")
  tipo          String
  puntoVenta    String
  numero        String
  fecha         DateTime
  cuit          String
  razonSocial   String
  montoNeto     Float    @default(0)
  iva           Float    @default(0)
  otrosTributos Float    @default(0)
  total         Float
  viajeId       String?
  viaje         Viaje?   @relation(fields: [viajeId], references: [id])
  createdAt     DateTime @default(now())

  @@unique([movimiento, puntoVenta, numero])
}
